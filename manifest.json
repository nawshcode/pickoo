{
  "manifest_version": 3,
  "name": "Pickoo",
  "version": "1.0.0",
  "description": "Pickoo is a lightweight Chrome extension with an HSL spectrum picker, screen eyedropper, HEX conversion, one-click clipboard copying, and a persistent saved-colour palette.",
  "action": {
    "default_popup": "extension.html",
    "default_title": "Pickoo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}
