{
  "manifest_version": 3,
  "name": "Pickoo",
  "version": "1.0.0",
  "description": "A sleek colour picker to fetch HEX codes, an eyedropper to pick colours from the screen and a gallery for saved colours.",
  "action": {
    "default_popup": "extension.html",
    "default_title": "Pickoo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}